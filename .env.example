# 必填：RunningHub 个人中心生成的 API Key
RUNNINGHUB_API_KEY=请替换为你的RunningHub_API_Key

# 默认使用：SCAIL-2 影视级角色动作驱动与替换
SCAIL_WEBAPP_ID=2064610888811900929

# 通常无需修改
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
MAX_DOWNLOAD_MB=500
SCHEMA_CACHE_SECONDS=600
LOG_LEVEL=INFO

# Railway 自动注入 RAILWAY_PUBLIC_DOMAIN，普通部署无需填写。
# 使用 Railway 自定义域名时填写纯域名，不要带 https:// 和路径。
# PUBLIC_DOMAIN=scail.example.com

# 仅当 inspect_scail_app 显示自动识别节点不正确时配置。
# 键支持 reference_image/source_video/mode/prompt/target_subject/reference_subject。
# SCAIL_NODE_OVERRIDES_JSON={"reference_image":{"nodeId":"10","fieldName":"image"},"source_video":{"nodeId":"7","fieldName":"video"}}

