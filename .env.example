# Required: RunningHub account API key
RUNNINGHUB_API_KEY=replace_with_your_runninghub_api_key
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_SHOW_CLI_BANNER=false

# Recommended public AI Apps
SCAIL_WEBAPP_ID=2067490689415471105
BERNINI_WEBAPP_ID=2062558412986216449

# Railway sets PORT automatically; do not hard-code PORT in Railway Variables.
DATA_DIR=/data
PUBLIC_BASE_URL=https://your-service.up.railway.app
MAX_UPLOAD_MB=300
MAX_DOWNLOAD_MB=2048
NODE_CACHE_TTL_SECONDS=3600
ALLOW_CONCURRENT_PIPELINES=false
KEEP_INTERMEDIATE_FILES=false

# Optional node overrides. Leave empty first, deploy, then call
# inspect_person_background_pipeline. Set BOTH NODE_ID and FIELD_NAME only if
# automatic mapping reports ambiguity or maps the wrong input.
# SCAIL_REFERENCE_IMAGE_NODE_ID=
# SCAIL_REFERENCE_IMAGE_FIELD_NAME=image
# SCAIL_SOURCE_VIDEO_NODE_ID=
# SCAIL_SOURCE_VIDEO_FIELD_NAME=video
# SCAIL_PROMPT_NODE_ID=
# SCAIL_PROMPT_FIELD_NAME=prompt
# BERNINI_SOURCE_VIDEO_NODE_ID=
# BERNINI_SOURCE_VIDEO_FIELD_NAME=video
# BERNINI_BACKGROUND_IMAGE_NODE_ID=
# BERNINI_BACKGROUND_IMAGE_FIELD_NAME=image
# BERNINI_PROMPT_NODE_ID=
# BERNINI_PROMPT_FIELD_NAME=prompt
